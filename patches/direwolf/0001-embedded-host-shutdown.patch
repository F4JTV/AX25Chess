+
 static int tq_is_empty (int chan);
 
 
@@ -140,6 +145,8 @@
 
 	dw_mutex_init(&tq_mutex);
 
+	tq_terminating = 0;
+
 /*
  * Windows and Linux have different wake up methods.
  * Put a wrapper around this someday to hide the details.
@@ -794,7 +801,7 @@
 	dw_printf ("tq_wait_while_empty (%d): is_empty = %d\n", chan, is_empty);
 #endif
 
-	if (is_empty) {
+	if (is_empty && ! tq_terminating) {
 #if DEBUG
 	  text_color_set(DW_COLOR_DEBUG);
 	  dw_printf ("tq_wait_while_empty (%d): SLEEP - about to call cond wait\n", chan);
@@ -1096,4 +1103,45 @@
 
 } /* end tq_count */
 
+/*-------------------------------------------------------------------
+ *
+ * Name:        tq_term / tq_is_terminating
+ *
+ * Purpose:     Let an embedding host shut the transmit side down.
+ *
+ * Description:	The stand-alone application never stops the transmit
+ *		threads; it simply exits.  An application that embeds the
+ *		modem needs them to return so the audio device can be
+ *		closed and everything re-initialised later.
+ *
+ *		tq_term sets a flag and wakes every transmit thread.
+ *		xmit_thread polls tq_is_terminating() and returns.
+ *		tq_init clears the flag again.
+ *
+ *--------------------------------------------------------------------*/
+
+void tq_term (void)
+{
+	int c;
+
+	tq_terminating = 1;
+
+	for (c = 0; c < MAX_RADIO_CHANS; c++) {
+#if __WIN32__
+	  if (wake_up_event[c] != NULL) {
+	    SetEvent (wake_up_event[c]);
+	  }
+#else
+	  dw_mutex_lock (&(wake_up_mutex[c]));
+	  pthread_cond_signal (&(wake_up_cond[c]));
+	  dw_mutex_unlock (&(wake_up_mutex[c]));
+#endif
+	}
+}
+
+int tq_is_terminating (void)
+{
+	return (tq_terminating);
+}
+
 /* end tq.c */
