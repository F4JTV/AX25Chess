diff -ruN a/src/recv.c b/src/recv.c
--- a/src/recv.c	2026-09-27 15:51:53.668799395 +0000
+++ b/src/recv.c	2026-09-27 15:51:53.669796774 +0000
@@ -119,6 +119,21 @@
 
 
 static struct audio_s *save_pa;		/* Keep pointer to audio configuration */
+
+/* Embedded host support.  Set by recv_term(), polled by the audio input */
+/* threads, which return instead of calling exit().  recv_init clears it. */
+
+static volatile int recv_terminating = 0;
+static volatile int recv_active_threads = 0;
+
+/* Set in each audio input thread so recv_thread_exiting() can tell whether */
+/* the thread that is about to end is one of ours. */
+
+#if defined(_MSC_VER)
+static __declspec(thread) int recv_is_input_thread = 0;
+#else
+static _Thread_local int recv_is_input_thread = 0;
+#endif
 					/* for later use. */
 
 /*------------------------------------------------------------------
@@ -151,6 +166,8 @@
 
 	save_pa = pa;
 
+	recv_terminating = 0;
+
 	for (a=0; a<MAX_ADEVS; a++) {
 
 	  if (pa->adev[a].defined) {
@@ -220,8 +237,11 @@
 /*
  * Get sound samples and decode them.
  */
+	recv_active_threads++;
+	recv_is_input_thread = 1;
+
 	eof = 0;
-	while ( ! eof) 
+	while ( ! eof && ! recv_terminating)
 	{
 
 	  int audio_sample;
@@ -278,12 +298,53 @@
 // Seimply terminate the application?  
 // Try to re-init the audio device a couple times before giving up?
 
+	if (recv_terminating) {
+	  recv_thread_exiting ();
+	  return (0);
+	}
+
 	text_color_set(DW_COLOR_ERROR);
 	dw_printf ("Terminating after audio device %d input failure.\n", a);
 	exit (1);
 }
 
 
+/*-------------------------------------------------------------------
+ *
+ * Name:        recv_term / recv_threads_active
+ *
+ * Purpose:     Let an embedding host stop the audio input threads.
+ *
+ * Description:	recv_term sets a flag.  Each input thread notices it
+ *		within one audio period and returns.  The host polls
+ *		recv_threads_active() until it reaches zero, then it is
+ *		safe to call audio_close().
+ *
+ *--------------------------------------------------------------------*/
+
+void recv_term (void)
+{
+	recv_terminating = 1;
+}
+
+/* Called by the host's exit() replacement on whatever thread is ending, */
+/* and by the input threads themselves: an input thread that ends by any */
+/* route stops being counted as active. */
+
+void recv_thread_exiting (void)
+{
+	if (recv_is_input_thread) {
+	  recv_is_input_thread = 0;
+	  recv_active_threads--;
+	}
+}
+
+int recv_threads_active (void)
+{
+	return (recv_active_threads);
+}
+
+
 
 
 
