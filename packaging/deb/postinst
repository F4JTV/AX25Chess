#!/bin/sh
# Reload the udev rules so a CM108 sound card plugged in after the install
# gets the right permissions without a reboot.
set -e
if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=hidraw >/dev/null 2>&1 || true
fi
exit 0
